150 Attenda Space-Saver Platform Bed","width":755,"height":521,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0511\/8990\/7644\/files\/Norix_Color_Palette_51443ca5-4357-4042-ab15-1005e8c54d5d.png?v=1712000540","variant_ids":[]}],"image":{"id":39118035124460,"product_id":6236193063100,"position":1,"created_at":"2023-07-25T08:40:57-04:00","updated_at":"2023-07-25T08:40:59-04:00","alt":"Norix ATN120 \/ ATN130 \/ ATN150 Attenda Space-Saver Platform Bed","width":600,"height":600,"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0511\/8990\/7644\/files\/ATN120_Space_Saver_Platform_Bed.png?v=1690288859","variant_ids":[]}}}